# Local development placeholders only. Copy to .env and change values. Never commit .env or real credentials.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (docker compose + backend)
POSTGRES_DB=jansetu
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/jansetu
DB_USERNAME=jansetu
DB_PASSWORD=change-me-locally

# JWT. Leave keys empty in the local profile to use an ephemeral in-memory key pair.
# Staging/production REQUIRE PEM keys (PKCS#8 private key, X.509 public key) from a secret manager.
JWT_ISSUER=https://jansetu.local
JWT_AUDIENCE=jansetu-api
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Set to true whenever the API is served over HTTPS.
REFRESH_COOKIE_SECURE=false

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Local synthetic seed data. Demo accounts are created only when this is set (local profile only).
SEED_ENABLED=true
SEED_DEMO_PASSWORD=

# Optional services (not required in Phase 1)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=jansetu-private
OBJECT_STORAGE_ACCESS_KEY=local-minio-user
OBJECT_STORAGE_SECRET_KEY=change-me-locally
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-locally
GRAFANA_ADMIN_PASSWORD=change-me-locally
KAFKA_BOOTSTRAP_SERVERS=
MAIL_PROVIDER_API_KEY=
